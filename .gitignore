# ==============================================================================
# Database & SQL Learning Repository - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Data, Dumps & Backups
# ------------------------------------------------------------------------------
# PostgreSQL / MySQL data directories & local mounts
pgdata/
data/
db_data/
*.rdb
*.aof

# Database dumps, raw backups, and large exported datasets
*.dump
*.sql.gz
*.sql.tar.gz
*.bak
*.backup
*.dmp
*.bin

# SQLite database files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Large data imports / exports (keep raw CSV/Parquet out of version control)
*.csv.gz
*.parquet
*.feather
/exports/
/imports/

# ------------------------------------------------------------------------------
# 2. Docker & Container Volumes
# ------------------------------------------------------------------------------
.docker/
docker-compose.override.yml
pgadmin/
pgadmin4/

# ------------------------------------------------------------------------------
# 3. Environment Variables & Credentials (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets/
credentials.json

# ------------------------------------------------------------------------------
# 4. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 5. Editors, IDEs & SQL Client Workspaces
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
*.code-workspace

# JetBrains / DataGrip / IntelliJ / PyCharm
.idea/
*.iml
*.ipr
*.iws

# Sublime Text / Atom / Eclipse
*.sublime-project
*.sublime-workspace
.project
.settings/

# Vim / Emacs swap and backup files
*.swp
*.swo
*~
\#*\#
.#*

# DBeaver / TablePlus / GUI connection caches
.dbeaver/
.dbeaver-data/
*.tableplusworkspace

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
scratch/
*.tmp

# ------------------------------------------------------------------------------
# 7. Helper Script Artifacts (Python / Node / CLI)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.coverage
htmlcov/
